{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "datafactorydemonew123"
		},
		"AzureDataLakeStorage1temp_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1temp'"
		},
		"Snowflaktemp_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Snowflaktemp'"
		},
		"AzureDataLakeStorage1temp_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsaccountnew1.dfs.core.windows.net/"
		},
		"Snowflaktemp_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sales_mart"
		},
		"Snowflaktemp_properties_typeProperties_role": {
			"type": "string",
			"defaultValue": "ACCOUNTADMIN"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "datafactorydemonew123_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage1temp_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1temp_accountKey')]"
					},
					"Snowflaktemp_password": {
						"value": "[parameters('Snowflaktemp_password')]"
					},
					"AzureDataLakeStorage1temp_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1temp_properties_typeProperties_url')]"
					},
					"Snowflaktemp_properties_typeProperties_database": {
						"value": "[parameters('Snowflaktemp_properties_typeProperties_database')]"
					},
					"Snowflaktemp_properties_typeProperties_role": {
						"value": "[parameters('Snowflaktemp_properties_typeProperties_role')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}